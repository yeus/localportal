{
  "scripts": {
    "build": "node build.js",
    "serve": "serve public",
    "watch": "chokidar 'content/**/*' index.html style.css -c 'yarn build'",
    "dev": "yarn build && concurrently -k -n watch,serve -c yellow,cyan \"yarn watch\" \"yarn serve\""
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.0",
    "marked": "^15.0.12",
    "serve": "^14.2.4"
  }
}
